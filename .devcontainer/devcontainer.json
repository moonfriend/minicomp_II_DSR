{
  "name": "mini-competition-II",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "onCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [8000, 11434],
  "portsAttributes": {
    "8000":  { "label": "FastAPI" },
    "11434": { "label": "Ollama" }
  },

  "postStartCommand": "ollama serve &",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/mini_competition_II/.venv/bin/python"
      }
    }
  }
}
